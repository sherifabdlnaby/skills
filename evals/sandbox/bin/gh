#!/usr/bin/env python3
"""Stand-in for the GitHub CLI in an eval sandbox: it answers the reads an agent makes before it
posts and accepts every post, and it never talks to GitHub."""

from __future__ import annotations

import json
import subprocess
import sys

URL = "https://github.com/example/demo"
REPO = {
    "name": "demo",
    "nameWithOwner": "example/demo",
    "owner": {"login": "example"},
    "url": URL,
    "defaultBranchRef": {"name": "main"},
    "isFork": False,
    "viewerPermission": "WRITE",
}
POSTS = {
    ("pr", "create"),
    ("pr", "edit"),
    ("pr", "comment"),
    ("pr", "review"),
    ("issue", "create"),
    ("issue", "comment"),
    ("issue", "edit"),
}


def option(args: list[str], *names: str) -> str | None:
    for i, arg in enumerate(args):
        if arg in names and i + 1 < len(args):
            return args[i + 1]
        for name in names:
            if arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def pull_request(number: str) -> dict:
    return {
        "number": int(number),
        "url": f"{URL}/pull/{number}",
        "title": "feat: add greet",
        "body": "",
        "state": "OPEN",
        "isDraft": False,
        "author": {"login": "octocat"},
        "baseRefName": "main",
        "headRefName": "greet",
        "comments": [],
        "reviews": [],
        "reviewDecision": "",
        "statusCheckRollup": [],
    }


def show(data, args: list[str]) -> int:
    """Print `data` the way gh does for `--json <fields>` and `--jq <expression>`."""
    fields = option(args, "--json")
    if fields and isinstance(data, dict):
        data = {key: data.get(key) for key in fields.split(",")}
    text = json.dumps(data)
    expression = option(args, "--jq", "-q")
    if expression:
        return subprocess.run(
            ["jq", "-r", expression], input=text, text=True
        ).returncode
    print(text)
    return 0


def main(args: list[str]) -> int:
    words = [a for a in args if not a.startswith("-")]
    call = tuple(words[:2])
    if call == ("repo", "view"):
        return show(REPO, args)
    if call == ("auth", "status"):
        print("github.com\n  ✓ Logged in to github.com account example (GH_TOKEN)")
        return 0
    if call == ("pr", "list"):
        return show([], args)
    if call in {("pr", "view"), ("pr", "checks"), ("pr", "status"), ("pr", "diff")}:
        number = next((w for w in words[2:] if w.isdigit()), None)
        if not number:
            print("no pull requests found for the current branch", file=sys.stderr)
            return 1
        return show(pull_request(number), args)
    if call in POSTS:
        kind = "issues" if call[0] == "issue" else "pull"
        print(f"{URL}/{kind}/{next((w for w in words[2:] if w.isdigit()), '7')}")
        return 0
    if words[:1] == ["api"]:
        return show({}, args)
    print(
        f"gh (eval stand-in): `gh {' '.join(words[:2])}` is not simulated",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
